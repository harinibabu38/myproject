# ==============================================================================
# AI-Enabled SaaS Subscription & Analytics Platform - Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application Configuration
# ------------------------------------------------------------------------------
PORT=3000
NODE_ENV=development

# ------------------------------------------------------------------------------
# 2. Database Configuration (PostgreSQL)
# ------------------------------------------------------------------------------
# Hostname for PostgreSQL. Use 'localhost' for local node execution,
# or 'postgres' when running inside Docker Compose network.
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=ai_saas_platform
DB_SYNCHRONIZE=true

# ------------------------------------------------------------------------------
# 3. Redis Configuration (Caching & BullMQ Job Queues)
# ------------------------------------------------------------------------------
# Hostname for Redis. Use 'localhost' for local node execution,
# or 'redis' when running inside Docker Compose network.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ------------------------------------------------------------------------------
# 4. Stripe Configuration (Test Mode)
# ------------------------------------------------------------------------------
# Get your test keys from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_placeholder
# Generated via Stripe CLI: stripe listen --forward-to localhost:3000/webhooks/stripe
STRIPE_WEBHOOK_SECRET=whsec_placeholder

# ------------------------------------------------------------------------------
# 5. Email / SMTP Configuration (Mailtrap Sandbox)
# ------------------------------------------------------------------------------
# Free testing sandbox from https://mailtrap.io
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=mailtrap_user_placeholder
SMTP_PASS=mailtrap_pass_placeholder
SMTP_FROM="AI SaaS <noreply@aisaassample.com>"

# ------------------------------------------------------------------------------
# 6. OpenAI Configuration (Optional AI Assistant / MCP features)
# ------------------------------------------------------------------------------
OPENAI_API_KEY=sk_placeholder
